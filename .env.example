# Copy to .env for local tooling (frontend build-time vars are PUBLIC_*).
# Worker secrets go in .dev.vars (see .dev.vars.example).

# Frontend (build-time)
PUBLIC_API_BASE_URL=""
# Optional R2 public bucket URL; empty = bundled placeholder images
PUBLIC_IMAGES_BASE_URL=""

# CI/CD secrets (set in GitHub → Settings → Secrets → Actions):
#   CLOUDFLARE_API_TOKEN    — token with D1, Workers, Pages, R2 edit perms
#   CLOUDFLARE_ACCOUNT_ID
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   STRIPE_PUBLISHABLE_KEY
