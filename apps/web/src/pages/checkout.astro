---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Checkout" description="Secure checkout — free shipping over $40.">
  <section class="container-page py-10">
    <h1 class="font-display text-3xl md:text-4xl font-bold tracking-tight">Checkout</h1>
    <div class="mt-8 grid lg:grid-cols-[1fr,380px] gap-8 items-start">
      <form id="checkout-form" class="card p-6 md:p-8 grid gap-4 sm:grid-cols-2">
        <h2 class="font-display font-bold text-lg sm:col-span-2">Contact & shipping</h2>
        <label class="text-sm font-semibold sm:col-span-2">Email
          <input name="email" type="email" required class="field mt-1.5" placeholder="you@example.com" autocomplete="email" />
        </label>
        <label class="text-sm font-semibold sm:col-span-2">Full name
          <input name="name" required minlength="2" class="field mt-1.5" placeholder="Ada Lovelace" autocomplete="name" />
        </label>
        <label class="text-sm font-semibold sm:col-span-2">Address line 1
          <input name="line1" required class="field mt-1.5" placeholder="123 Hydration Way" autocomplete="address-line1" />
        </label>
        <label class="text-sm font-semibold sm:col-span-2">Address line 2 <span class="text-slate-text font-normal">(optional)</span>
          <input name="line2" class="field mt-1.5" autocomplete="address-line2" />
        </label>
        <label class="text-sm font-semibold">City
          <input name="city" required class="field mt-1.5" autocomplete="address-level2" />
        </label>
        <label class="text-sm font-semibold">State / Region
          <input name="state" class="field mt-1.5" autocomplete="address-level1" />
        </label>
        <label class="text-sm font-semibold">Postal code
          <input name="postalCode" required class="field mt-1.5" autocomplete="postal-code" />
        </label>
        <label class="text-sm font-semibold">Country
          <input name="country" required value="United States" class="field mt-1.5" autocomplete="country-name" />
        </label>

        <fieldset class="sm:col-span-2">
          <legend class="text-sm font-semibold">Shipping method</legend>
          <div class="mt-2 grid gap-2">
            <label class="flex items-center gap-3 rounded-2xl border p-4 cursor-pointer transition-colors has-checked:border-brand has-checked:bg-[color-mix(in_srgb,var(--brand)_6%,transparent)]">
              <input type="radio" name="shippingMethod" value="standard" checked class="accent-[var(--brand)]" />
              <span class="flex-1">
                <span class="block text-sm font-semibold">Standard</span>
                <span class="block text-xs text-slate-text">3–5 business days · $4.99 (free over $40)</span>
              </span>
            </label>
            <label class="flex items-center gap-3 rounded-2xl border p-4 cursor-pointer transition-colors has-checked:border-brand has-checked:bg-[color-mix(in_srgb,var(--brand)_6%,transparent)]">
              <input type="radio" name="shippingMethod" value="express" class="accent-[var(--brand)]" />
              <span class="flex-1">
                <span class="block text-sm font-semibold">Express</span>
                <span class="block text-xs text-slate-text">1–2 business days · $9.99</span>
              </span>
            </label>
          </div>
        </fieldset>

        <p id="checkout-error" class="sm:col-span-2 text-sm text-red-500" hidden></p>
        <button type="submit" id="checkout-submit" class="btn btn-primary sm:col-span-2 text-base">Place order</button>
        <p class="sm:col-span-2 text-xs text-slate-text text-center">
          Demo mode is enabled by default — no real payment is processed. Connect Stripe keys in
          <code>.dev.vars</code> and set <code>DEMO_MODE=false</code> for live payments.
        </p>
      </form>

      <aside class="card p-6 sticky top-24">
        <h2 class="font-display font-bold text-lg">Order summary</h2>
        <div id="checkout-lines" class="mt-4 space-y-3 text-sm"><!-- populated --></div>
        <div class="mt-4 pt-4 border-t space-y-2 text-sm" style="border-color: color-mix(in srgb, var(--ink) 10%, transparent)">
          <div class="flex justify-between"><span class="text-slate-text">Subtotal</span><span id="co-subtotal">—</span></div>
          <div class="flex justify-between" id="co-discount-row" hidden><span class="text-slate-text">Discount</span><span id="co-discount" class="text-brand font-semibold"></span></div>
          <div class="flex justify-between"><span class="text-slate-text">Shipping</span><span id="co-shipping">—</span></div>
          <div class="flex justify-between font-bold text-base pt-1"><span>Total</span><span id="co-total">—</span></div>
        </div>
      </aside>
    </div>
  </section>

  <script>
    import '../scripts/checkout-page';
  </script>
</BaseLayout>
