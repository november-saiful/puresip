---
// Catalog card for a product DTO from the API.
export interface VariantLite {
  id: number;
  color: string;
  colorHex: string;
  price: number;
  stock: number;
  images: string[];
}
export interface ProductLite {
  slug: string;
  name: string;
  category: string;
  shortDescription: string;
  basePrice: number;
  rating?: number;
  reviewCount?: number;
  variants: VariantLite[];
}
interface Props {
  product: ProductLite;
}
const { product } = Astro.props;
const first = product.variants[0];
const image = first?.images[0];
const inStock = product.variants.some((v) => v.stock > 0);
const colors = product.variants.map((v) => ({ name: v.color, hex: v.colorHex }));
const uniqueColors = colors.filter((c, i) => colors.findIndex((x) => x.hex === c.hex) === i);
---

<a href={`/product/${product.slug}`} class="card card-hover group block overflow-hidden">
  <div class="aspect-square relative overflow-hidden" style="background: color-mix(in srgb, var(--brand) 7%, var(--mist))">
    {image ? (
      <img
        src={image}
        alt={`${product.name} in ${first?.color ?? 'default'} color`}
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
        width="600"
        height="600"
      />
    ) : (
      <div class="absolute inset-0 grid place-items-center">
        <div class="w-14 h-24 rounded-2xl" style="background: linear-gradient(160deg, var(--brand), var(--aqua)); opacity: .85"></div>
      </div>
    )}
    {!inStock && (
      <span class="absolute top-3 left-3 rounded-full bg-black/70 px-3 py-1 text-xs font-semibold text-white">Sold out</span>
    )}
  </div>
  <div class="p-5">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-display font-semibold leading-snug">{product.name}</h3>
      <p class="font-semibold text-brand whitespace-nowrap">${product.basePrice.toFixed(2)}</p>
    </div>
    <p class="mt-1.5 text-sm text-slate-text line-clamp-2">{product.shortDescription}</p>
    <div class="mt-3 flex items-center justify-between">
      <div class="flex gap-1.5" aria-hidden="true">
        {uniqueColors.slice(0, 6).map((c) => (
          <span class="h-4 w-4 rounded-full border border-black/10" style={`background: ${c.hex}`} title={c.name}></span>
        ))}
      </div>
      {product.rating ? (
        <span class="text-xs font-medium text-slate-text">★ {product.rating.toFixed(1)} ({product.reviewCount})</span>
      ) : null}
    </div>
  </div>
</a>
